{
    "enabled": true,
    "sync_frequency": "daily",
    "sync_new_only": false,
    "source_project_id": "TEST1ID",
    "remote_project_id": "SyncProjectId",
    "remote_url": "http://localhost:8080/xnat",
    "identifiers": "use_local",
    "anonymize": true,
    "project_resources": {
        "sync_type": "include",
        "items": [
            "RES1"
        ]
    },
    "subject_resources": {
        "sync_type": "include",
        "items": [
            "S1RESOURCE",
            "S2RESOURCE"
        ]
    },
    "subject_assessors": {
        "sync_type": "include",
        "xsi_types": [
            {
                "xsi_type": "dpuk:dpukAssessmentData",
                "needs_ok_to_sync": false,
                "resources": {
                    "sync_type": "include",
                    "items": [
                        "DPUK1RESOURCE"
                    ]
                }
            },
            {
                "xsi_type": "hcp:subjectMetaData",
                "needs_ok_to_sync": false,
                "resources": {
                    "sync_type": "none",
                    "items": []
                }
            }
        ]
    },
    "imaging_sessions": {
        "sync_type": "include",
        "xsi_types": [
            {
                "xsi_type": "xnat:mrSessionData",
                "needs_ok_to_sync": true,
                "resources": {
                    "sync_type": "exclude",
                    "items": [
                        "MR1RESOURCE",
                        "MR2RESOURCE"
                    ]
                },
                "session_assessors": {
                    "sync_type": "include",
                    "xsi_types": [
                        {
                            "xsi_type": "qc:qcAssessmentData",
                            "needs_ok_to_sync": false,
                            "resources": {
                                "sync_type": "include",
                                "items": [
                                    "QCASSESSMENT1"
                                ]
                            }
                        }
                    ]
                },
                "scan_types": {
                    "sync_type": "include",
                    "items": [
                        "T1w",
                        "T2w",
                        "fMRI",
                        "rMRI"
                    ]
                },
                "scan_resources": {
                    "sync_type": "include",
                    "items": [
                        "DICOM",
                        "NIFTI"
                    ]
                }
            }
        ]
    }
}
