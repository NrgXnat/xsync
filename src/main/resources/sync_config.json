{
	"enabled": true,
	"sync_frequency": "daily",
	"sync_new_only": false,
	"source_project_id": "TEST1ID",
	"remote_project_id": "SyncProjectId",
	"remote_url": "http://localhost:8080/xnat",
	"identifiers": "use_local",
	"anonymize": true,
	"notification_emails": "abc@xyz.com,pqr@mno.co.in",
	"project_resources": {
		"sync_type": "include",
		"items": [
			"RES1"
		]
	},
	"subject_resources": {
		"sync_type": "include",
		"items": [
			"S1RESOURCE",
			"S2RESOURCE"
		]
	},
	"subject_assessors": {
		"sync_type": "include",
		"xsi_types": [
			{
				"xsi_type": "dpuk:dpukAssessmentData",
				"resources": {
					"sync_type": "include",
					"items": [
						"DPUK1RESOURCE"
					]
				},
				"filters": [
					{
						"sync_type": "include",
						"xml_path": "label",
						"filter_type": "regex",
						"filter_values": [
							"^Patient.*"
						]
					}
				]
			},
			{
				"xsi_type": "hcp:subjectMetaData",
				"resources": {
					"sync_type": "none",
					"items": []
				},
				"filters": [
					{
						"sync_type": "include",
						"xml_path": "pi_firstname",
						"filter_type": "contains",
						"filter_values": [
							"John",
							"Doe"
						]
					}
				]
			}
		]
	},
	"imaging_sessions": {
		"sync_type": "include",
		"xsi_types": [
			{
				"xsi_type": "xnat:mrSessionData",
				"needs_ok_to_sync": true,
				"resources": {
					"sync_type": "exclude",
					"items": [
						"MR1RESOURCE",
						"MR2RESOURCE"
					]
				},
				"session_assessors": {
					"sync_type": "include",
					"xsi_types": [
						{
							"xsi_type": "qc:qcAssessmentData",
							"resources": {
								"sync_type": "include",
								"items": [
									"QCASSESSMENT1"
								]
							}
						}
					]
				},
				"scan_types": {
					"sync_type": "include",
					"items": [
						"T1w",
						"T2w",
						"fMRI",
						"rMRI"
					]
				},
				"scan_resources": {
					"sync_type": "include",
					"items": [
						"DICOM",
						"NIFTI"
					]
				},
				"filters": [
			          {
			            "sync_type": "include",
			            "xml_path": "xnat:experimentdata/meta/status",
			            "filter_type": "contains",
			            "filter_values": [
			              "active"
			            ]
			          }
			        ],
				"scan_filters": [
					{
						"sync_type": "include",
						"xml_path": "series_description",
						"filter_type": "regex",
						"filter_values": [
							"^t1.*"
						]
					},
					{
						"sync_type": "exclude",
						"xml_path": "quality",
						"filter_type": "contains",
						"filter_values": [
							"questionable",
							"unusable"
						]
					},
					{
						"sync_type": "include",
						"xml_path": "xnat:imageScanData/frames",
						"filter_type": "regex",
						"filter_values": [
							"^(1\\d{2}|\\d{1,2})(\\.\\d{1,})?$"
						]
					},
					{
						"sync_type": "include",
						"xml_path": "xnat:mrScanData/fieldStrength",
						"filter_type": "regex",
						"filter_values": [
							"^([6-9]|\\d{2,})(\\.\\d{1,})?$"
						]
					}
				]
			}
		]
	}
}
