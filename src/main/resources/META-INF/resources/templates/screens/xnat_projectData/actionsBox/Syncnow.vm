<!-- allowGuest: false -->
<script type="text/javascript" >
	XNAT.xhr.getJSON({
	  url:XNAT.url.csrfUrl('/xapi/xsync/setup/projects/'+XNAT.data.context.project),
	  type:"GET",
	  success: function(data){
	      var configuration = data;
	      if (configuration.enabled === true) {	
	        document.getElementById('showSyncData').style.display="";
	      }else {
	        document.getElementById('showSyncData').style.display="none";
	      }
	  },
	  error: function(o) {
	      document.getElementById('showSyncData').style.display="none";
	  }
	});




function syncNow(projectId) {
	var exporturl = serverRoot + '/xapi/xsync/projects/'+projectId+'?XNAT_CSRF='+csrfToken ;
	$.ajax({
	  url:exporturl,
	  type:"POST",
	  success: function(data){
			  xmodal.alert({
					title: 'Project Synchronization',
					content: 'Project ' + projectId + ' synchronization has started. An email notification will be sent once synchronization is complete.',
					label: 'OK'
				});
	  
	  },
	  error: ajaxCallFailed
	});
};

	function ajaxCallFailed(o) {
		xmodal.loading.close();
		if (!window.leaving) {
			//alert(o.status + " " + o.statusText + " " +  o.responseText);
			if (o.status == "417") {
		    		xModalMessage('Unable to initiate project synchronization', 'Project is not configured for synchronization. Please setup synchronization first');
			}else 
		    		xModalMessage('Unable to initiate project synchronization', 'Unable to initiate project synchronization');
		}

	};

</script>

#if($data.getSession().getAttribute("userHelper").canDelete($project))
<div id="showSyncData">
<li class="yuimenuitem">
	<a class="yuimenuitemlabel" href="javascript:syncNow('$!{project.getId()}');">Sync Data</a>
</li>
</div>
#end
