<script type="text/javascript" >
	XNAT.xhr.getJSON({
	  url:XNAT.url.csrfUrl('/xapi/xsync/setup/projects/'+XNAT.data.context.project),
	  type:"GET",
	  success: function(data){
	      var configuration = data;
	      var xnatXsiType='$om.getXSIType()';
	      var visi = 'hidden';
	      var visibilityShowDoesNotNeedOkToSync = 'hidden';
	      if (typeof configuration.imaging_sessions === 'undefined') {
		  visibilityShowDoesNotNeedOkToSync = 'visible';		      
	      }else {
		if (typeof configuration.imaging_sessions.xsi_types === 'undefined') {
		  visibilityShowDoesNotNeedOkToSync = 'visible';		      
		}else {
		  for (i = 0; i < configuration.imaging_sessions.xsi_types.length; i++) {
		     var xsiType = configuration.imaging_sessions.xsi_types[i];
		     if (xsiType.xsi_type==xnatXsiType) {
		         if (typeof xsiType.needs_ok_to_sync === 'undefined') {
		            visibilityShowDoesNotNeedOkToSync = 'visible';		      
		         }else if (xsiType.needs_ok_to_sync) {
		            visi = 'visible';
		         }
		     }
		  }
		}
	      }
	      document.getElementById('showDivIfSynchronizationNotConfigured').style.visibility="hidden";
	      document.getElementById('showDivIfSynchronizationConfigured').style.visibility=visi;
	      document.getElementById('showDoesNotNeedOkToSync').style.visibility=visibilityShowDoesNotNeedOkToSync;

	  },
	  error: function(o) {
	      document.getElementById('showDivIfSynchronizationConfigured').style.visibility="hidden";
	      document.getElementById('showDivIfSynchronizationNotConfigured').style.visibility="visible";
	  }
	});


function setOkToSync(projectId,xnat_id, exp_label) {
	var syncChoice = document.getElementById('OkToSync').checked;
	var exporturl = serverRoot + '/xapi/xsync/experiments/'+xnat_id+'?okToSync='+syncChoice+'&XNAT_CSRF='+csrfToken ;
	var text = 'Experiment ' + exp_label + ' has been marked ok to sync. This experiment will be synced in the next synchronization cycle of the project ' + projectId;
	if (!syncChoice) {
		text = 'Experiment ' + exp_label + ' has been marked NOT ok to sync. This experiment will be not be synced in the next synchronization cycle of the project ' + projectId;
	}
	$.ajax({
	  url:exporturl,
	  type:"POST",
	  success: function(data){
			  xmodal.alert({
					title: 'Data Synchronization',
					content: text ,
					label: 'OK'
				});
	  
	  },
	  error: ajaxCallFailed
	});
};

function ajaxCallFailed(o) {
	xmodal.loading.close();
	if (!window.leaving) {
		//alert(o.status + " " + o.statusText + " " +  o.responseText);
	    	xModalMessage('Unable to mark experiment as Ok to sync', 'Unable to mark experiment as Ok to sync');
	}
}

function manualSync(projectId,xnat_id, exp_label) {
	var syncurl = serverRoot + '/xapi/xsync/syncexperiment/'+xnat_id+'?XNAT_CSRF='+csrfToken ;
	xmodal.confirm({
		title: 'Confirm Manual Sync',
		width: '500px',
		height: '300px',
		content:  'Click "OK" to begin synchronization. &nbsp;Please note warnings below.<br><br><b>Note that this could block other sync operations, as multiple concurrent sync processes are not allowed. &nbsp;' +
				' Use the <em>Mark Session for Sync</em> button to request sync as part of the standard project sync process.</b><br><br><b>Note also that this may cause ' +
				'loss of data on the remote side as any current session will be overwritten</b>.',
		okAction: function() {
					$.ajax({
					  url:syncurl,
					  type:"POST",
					  success: function(data){
							xmodal.alert({
									title: 'Data Synchronization',
									content: "Sync request for this experiment (" + exp_label + ") has been sent." ,
									label: 'OK'
								});
					  
					  },
					  error: function(data){
							xmodal.loading.close();
							if (!window.leaving) {
								if (data.status == "423") {
							 		xModalMessage('Manual sync failed','Another sync operation is running.  Please try again later');
								} else {
							 		xModalMessage('Manual sync failed','Unable to sync session ' + exp_label + '.  (' + data.statusText + ')');
								}
							}
					  }
					})
		}
	});
};

function requestSync(projectId,xnat_id, exp_label) {
	var syncurl = serverRoot + '/xapi/xsync/requestSync/'+xnat_id+'?XNAT_CSRF='+csrfToken ;
	xmodal.confirm({
		width: '500px',
		height: '250px',
		title: 'Request Manual Sync',
		content:  'Click "OK" to mark this session for syncing. &nbsp;Please note warning below.  ' + 
				'<br><br><b>Note that this may cause loss of data on the remote side as any current session will be overwritten</b>.',
		okAction: function() {
					$.ajax({
					  url:syncurl,
					  type:"POST",
					  success: function(data){
							xmodal.alert({
									title: 'Data Synchronization',
									content: "Session (" + exp_label + ") has been marked to sync." ,
									label: 'OK'
								});
					  
					  },
					  error: function(data){
							xmodal.loading.close();
							if (!window.leaving) {
							 	xModalMessage('Sync request failed','Unable to mark session ' + exp_label + ' to sync.  (' + data.statusText + ')');
							}
					  }
					})
		}
	});
};

</script>

