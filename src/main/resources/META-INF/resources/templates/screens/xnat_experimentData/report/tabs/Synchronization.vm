<script type="text/javascript" >
	XNAT.xhr.getJSON({
	  url:XNAT.url.csrfUrl('/xapi/xsync/setup/projects/'+XNAT.data.context.project),
	  type:"GET",
	  success: function(data){
	      var configuration = JSON.parse(data);
	      var xnatXsiType='$om.getXSIType()';
	      var visi = 'hidden';
	      var visibilityShowDoesNotNeedOkToSync = 'hidden';
	      if (typeof configuration.imaging_sessions === 'undefined') {
		  visibilityShowDoesNotNeedOkToSync = 'visible';		      
	      }else {
		if (typeof configuration.imaging_sessions.xsi_types === 'undefined') {
		  visibilityShowDoesNotNeedOkToSync = 'visible';		      
		}else {
		  for (i = 0; i < configuration.imaging_sessions.xsi_types.length; i++) {
		     var xsiType = configuration.imaging_sessions.xsi_types[i];
		     if (xsiType.xsi_type==xnatXsiType) {
		         if (typeof xsiType.needs_ok_to_sync === 'undefined') {
		            visibilityShowDoesNotNeedOkToSync = 'visible';		      
		         }else if (xsiType.needs_ok_to_sync) {
		            visi = 'visible';
		         }
		     }
		  }
		}
	      }
	      document.getElementById('showDivIfSynchronizationNotConfigured').style.visibility="hidden";
	      document.getElementById('showDivIfSynchronizationConfigured').style.visibility=visi;
	      document.getElementById('showDoesNotNeedOkToSync').style.visibility=visibilityShowDoesNotNeedOkToSync;

	  },
	  error: function(o) {
	      document.getElementById('showDivIfSynchronizationConfigured').style.visibility="hidden";
	      document.getElementById('showDivIfSynchronizationNotConfigured').style.visibility="visible";
	  }
	});


function setOkToSync(projectId,xnat_id, exp_label) {
	var syncChoice = document.getElementById('OkToSync').checked;
	var exporturl = serverRoot + '/xapi/xsync/experiments/'+xnat_id+'?okToSync='+syncChoice+'&XNAT_CSRF='+csrfToken ;
	var text = 'Experiment ' + exp_label + ' has been marked ok to sync. This experiment will be synced in the next synchronization cycle of the project ' + projectId;
	if (!syncChoice) {
		text = 'Experiment ' + exp_label + ' has been marked NOT ok to sync. This experiment will be not be synced in the next synchronization cycle of the project ' + projectId;
	}
	$.ajax({
	  url:exporturl,
	  type:"POST",
	  success: function(data){
			  xmodal.alert({
					title: 'Data Synchronization',
					content: text ,
					label: 'OK'
				});
	  
	  },
	  error: ajaxCallFailed
	});
};

	function ajaxCallFailed(o) {
		xmodal.loading.close();
		if (!window.leaving) {
			//alert(o.status + " " + o.statusText + " " +  o.responseText);
		    	xModalMessage('Unable to mark experiment as Ok to sync', 'Unable to mark experiment as Ok to sync');
		}

	};

</script>

