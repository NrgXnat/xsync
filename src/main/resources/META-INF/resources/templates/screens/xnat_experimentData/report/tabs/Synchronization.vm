<script type="text/javascript" >
function setOkToSync(projectId,xnat_id, exp_label) {
	var syncChoice = document.getElementById('OkToSync').checked;
	var exporturl = serverRoot + '/xapi/xsync/experiments/'+xnat_id+'?okToSync='+syncChoice+'&XNAT_CSRF='+csrfToken ;
	var text = 'Experiment ' + exp_label + ' has been marked ok to sync. This experiment will be synced in the next synchronization cycle of the project ' + projectId;
	if (!syncChoice) {
		text = 'Experiment ' + exp_label + ' has been marked NOT ok to sync. This experiment will be not be synced in the next synchronization cycle of the project ' + projectId;
	}
	$.ajax({
	  url:exporturl,
	  type:"POST",
	  success: function(data){
			  xmodal.alert({
					title: 'Data Synchronization',
					content: text ,
					label: 'OK'
				});
	  
	  },
	  error: ajaxCallFailed
	});
};

	function ajaxCallFailed(o) {
		xmodal.loading.close();
		if (!window.leaving) {
			//alert(o.status + " " + o.statusText + " " +  o.responseText);
		    	xModalMessage('Unable to mark experiment as Ok to sync', 'Unable to mark experiment as Ok to sync');
		}

	};

</script>

