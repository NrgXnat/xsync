# Copy to .env and fill in values for the XNAT instance under test.
# The instance must be running xsyncPlugin 1.8.2-SNAPSHOT or later; the suite
# aborts in global setup if the endpoints added in that version are absent.
XNAT_URL=https://your-xnat-instance.example.com
ADMIN_USER=admin
ADMIN_PASS=admin

# A non-site-admin account. Used to prove that the XsyncAdministrator role,
# and only that role, opens the site-wide XSync administration endpoints.
NON_ADMIN_USER=testuser
NON_ADMIN_PASS=testuser123

# ---------------------------------------------------------------------------
# Cross-instance transfer tests (admin.crossXnatTransfer.spec.ts) -- OPTIONAL
#
# A second, reachable XNAT instance that receives a real transfer. Any XNAT
# the given account can create a project on will do; nothing assumes a
# particular hostname, network, or CI system. Leave REMOTE_XNAT_URL unset to
# skip these tests; if it is set, both credential values are required and the
# run fails on a half-configured remote rather than silently skipping.
#
# The tests create their own uniquely named project on the receiver and
# delete it afterwards. Existing data on the receiver is not touched.
# ---------------------------------------------------------------------------
#REMOTE_XNAT_URL=https://receiving-xnat.example.org
#REMOTE_ADMIN_USER=admin
#REMOTE_ADMIN_PASS=admin
