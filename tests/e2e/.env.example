# Copy to .env and fill in values for the XNAT instance under test.
# The instance must be running xsyncPlugin 1.8.2-SNAPSHOT or later; the suite
# aborts in global setup if the endpoints added in that version are absent.
XNAT_URL=https://your-xnat-instance.example.com
ADMIN_USER=admin
ADMIN_PASS=admin

# A non-site-admin account. Used to prove that the XsyncAdministrator role,
# and only that role, opens the site-wide XSync administration endpoints.
NON_ADMIN_USER=testuser
NON_ADMIN_PASS=testuser123
